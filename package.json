  "repository": {
    "type": "git",
    "url": "https://github.com/yogsoth-ai/wiki-vault.git"
  },
  "bugs": {
    "url": "https://github.com/yogsoth-ai/wiki-vault/issues"
  },
  "homepage": "https://github.com/yogsoth-ai/wiki-vault#readme",
  "author": "yogsoth-ai",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20"
  }
